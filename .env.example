# Backend credentials only. Copy to .env and supply your own values.
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
# Optional full web search. Never put this key in frontend environment variables.
# Leave provider blank to select Tavily when a key exists, otherwise public search.
WEB_SEARCH_PROVIDER=
TAVILY_API_KEY=

# Optional: user document library and CPU embedding cache, independent of legacy project corpus.
# AGENTICRAG_KNOWLEDGE_DIR=data/knowledge
# AGENTICRAG_EMBEDDING_CACHE=data/knowledge/models
